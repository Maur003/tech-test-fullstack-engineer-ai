# Create a key at https://aistudio.google.com/apikey and paste it below.
# Restart `npm run dev` after saving.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional path to the catalog database. Defaults to data/games.sqlite.
# The first run copies data/games.json into a new database. Delete the
# database file to load that seed again.
# GAMES_DATA_FILE=
